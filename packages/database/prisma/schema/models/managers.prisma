/// Менеджер проекта для обзвона (Callback Widget, вкладка «Звонки»). Управляемая сущность (CRUD в ЛК).
/// `type` — String ('SIP'|'Телефон'), синхронно с ProjectIntegration.managerType и веткой
/// resolveMangoCallConfig (=== 'Телефон'). Привязка звонка — round-robin при инициации. plan-wid-call.md.
model Manager {
  id        String  @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name    String
  type    String // 'SIP' | 'Телефон'
  address String // extension / внешний номер
  enabled Boolean @default(true)

  requests Request[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([projectId])
  @@map("managers")
}
