model PurchasedPaymentPlanOption {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  paymentPlanOption   PaymentPlanOptions @relation(fields: [paymentPlanOptionId], references: [id], onDelete: Cascade)
  paymentPlanOptionId String

  purchasedAt  DateTime @default(now()) @map("purchased_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([userId, paymentPlanOptionId])
  @@map("purchased_payment_plan_options")
}