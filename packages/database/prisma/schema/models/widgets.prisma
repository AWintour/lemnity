model Widget {
  id         String   @id @default(cuid()) @map("id")

  projectId  String @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  type       WidgetType
  enabled    Boolean  @default(false)
  config     Json?
  configVersion Int?

  // Тарификация (см. plans/plan-wid.md в lmntai). Виджет активен, пока paidUntil > now.
  // При создании ставится createdAt + 5 дней (бесплатный период). Оплата подписки в ЛК
  // lemnity.ru продлевает на месяц через вебхук /api/lemnity/widget-subscription.
  paidUntil     DateTime? @map("paid_until")
  lemnityUserId String?   @map("lemnity_user_id") // lemnity.ru userId плательщика (для «Мои виджеты» в ЛК)
  lastPaymentId String?   @map("last_payment_id") // идемпотентность вебхука подписки

  requests   Request[]

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@index([projectId])
  @@unique([projectId, name])  // или [projectId, type] — по вашему правилу уникальности
  @@map("widgets")
}

enum WidgetType {
  WHEEL_OF_FORTUNE
  CONVEYOR_OF_LUCK
  CONVEYOR_OF_GIFTS
  ACTION_TIMER
  POSTCARD
  CHEST_WITH_ACTION
  ADVENT_CALENDAR
  TEASER
  FAB_MENU
  ANNOUNCEMENT
  EVENT_TIMER
  NOTIFICATION
  VIDEO_WIDGET
  CALLBACK
}
