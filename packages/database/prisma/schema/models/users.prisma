enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())

  email     String   @unique
  phone     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)

  // lemnity.ru (lmntai) userId, проставляется при SSO-входе (ticket-exchange).
  // Мост email↔lemnityUserId для аккаунтной подписки Callback (см. plan-wid-call.md, Фаза B).
  lemnityUserId String? @unique @map("lemnity_user_id")

  passwordResetTokens PasswordResetToken[]
  projects  Project[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
