enum PaymentOptionEnum {
  BRANDING
}

model PaymentPlanOptions {
  id String @id @default(cuid())

  name             String
  type             PaymentOptionEnum
  price            Decimal @default(0) @db.Decimal(10, 2)
  enabled          Boolean @default(false)
  isBilledAnnually Boolean @default(false) @map("is_billed_annually")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  paymentPlansPaymentOptions  PaymentPlan[] @relation(name: "paymentPlanOptionsRelation")
  paymentPlansIncludedOptions PaymentPlan[] @relation(name: "includedPlanOptionsRelation")
  
  users User[]

  @@map("payment_plan_options")
}
