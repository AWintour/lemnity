/// Интеграция проекта с внешним сервисом (Фаза 2, гибрид). Для `mango_office` — BYO-аккаунт клиента:
/// его ключ/соль (шифрованные secret-cipher) + параметры звонка. Если записи нет/выключена — звонки
/// идут через наш глобальный аккаунт (env). Секреты НЕ кладём в config виджета. plan-wid-call.md, Фаза 2.
model ProjectIntegration {
  id        String  @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    String // 'mango_office'
  enabled Boolean @default(true)

  // Секреты Server API Mango (шифрованные AES-256-GCM):
  apiKeyEnc  String? @map("api_key_enc")
  apiSaltEnc String? @map("api_salt_enc")

  // Параметры звонка BYO-аккаунта:
  managerType    String? @map("manager_type")    // 'SIP' | 'Телефон'
  managerAddress String? @map("manager_address")  // extension или внешний номер оператора
  lineNumber     String? @map("line_number")      // АОН
  callMode       String? @map("call_mode")        // 'manager' | 'robot'
  delaySeconds   Int?    @map("delay_seconds")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([projectId, type])
  @@map("project_integrations")
}
