# Скопируйте в .env и заполните. .env в git НЕ коммитится (см. .gitignore).

# --- Gmail SMTP -----------------------------------------------------------
# SMTP_USER — ваш gmail-адрес (или адрес домена на Google Workspace).
# SMTP_PASS — App Password (16 символов), НЕ обычный пароль от аккаунта.
#   Включите 2FA → https://myaccount.google.com/apppasswords → создайте пароль.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Отправитель ----------------------------------------------------------
SENDER_NAME=Александр, Lemnity
REPLY_TO=hello@lemnity.ru
SENDER_TELEGRAM=@lemnity_ru

# --- Подстановки в письма -------------------------------------------------
DEMO_LINK=https://lemnity.ru/demo
PARTNER_LINK=https://lemnity.ru/partners
COMMISSION=20–30%

# --- Лимиты и темп (антиспам) ---------------------------------------------
# 20–30 писем/день с прогретого домена. Паузы между письмами — в секундах.
DAILY_LIMIT=25
SEND_MIN_DELAY=30
SEND_MAX_DELAY=90
